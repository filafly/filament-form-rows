{
  "name": "filafly/filament-form-rows",
  "description": "Settings-style form rows for Filament: label and help text on the left, the control on the right, divided by hairlines.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "Laravel",
    "Filament",
    "forms",
    "settings",
    "rows"
  ],
  "homepage": "https://filafly.com/plugins/filament-form-rows",
  "authors": [
    {
      "role": "Developer",
      "name": "Nolan Nordlund",
      "email": "nolan@filafly.com",
      "homepage": "https://www.filafly.com/"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/filament": "^4.0 || ^5.0",
    "spatie/laravel-package-tools": "^1.92"
  },
  "autoload": {
    "psr-4": {
      "Filafly\\FormRows\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Filafly\\FormRows\\FormRowsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.3"
  },
  "autoload-dev": {
    "psr-4": {
      "Filafly\\FormRows\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint"
  }
}
